{
  "$schema": "https://openapi.vercel.sh/microfrontends.json",
  "applications": {
    "medlink": {
      "packageName": "@medlink/web",
      "development": {
        "fallback": "medlink-lovat.vercel.app",
        "local": 3000
      }
    },
    "medlink-admin": {
      "packageName": "@medlink/admin",
      "routing": [
        { "paths": ["/admin", "/admin/:path*", "/control-center", "/control-center/:path*"] }
      ],
      "development": { "local": 3001 }
    },
    "medlink-patient": {
      "packageName": "@medlink/patient-app",
      "routing": [{ "paths": ["/patient", "/patient/:path*"] }],
      "development": { "local": 3002 }
    },
    "medlink-pharmacist": {
      "packageName": "@medlink/pharmacist-app",
      "routing": [{ "paths": ["/pharmacist", "/pharmacist/:path*"] }],
      "development": { "local": 3003 }
    },
    "medlink-pharmacy": {
      "packageName": "@medlink/pharmacy-app",
      "routing": [{ "paths": ["/pharmacy", "/pharmacy/:path*"] }],
      "development": { "local": 3004 }
    }
  }
}
