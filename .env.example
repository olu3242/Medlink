NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info

# Server-only. Never prefix with NEXT_PUBLIC_ -- these must never reach the
# client bundle. Used only by apps/web/app/api/whatsapp/webhook/route.ts
# (ADR 0004).
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
WHATSAPP_APP_SECRET=replace-with-meta-app-secret
WHATSAPP_VERIFY_TOKEN=replace-with-a-random-verification-token

# Server-only. Used only by apps/patient/lib/assistant.ts (Alice, AG-02) --
# the first real AI Gateway consumer. ANTHROPIC_MODEL has no default on
# purpose: pick a real, currently-supported model id for your deployment
# rather than trusting a hardcoded default that will eventually go stale.
ANTHROPIC_API_KEY=replace-with-a-real-anthropic-api-key
ANTHROPIC_MODEL=replace-with-a-real-anthropic-model-id
