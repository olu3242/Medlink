# MedLink local environment template
# Copy this file to .env.local and replace placeholders locally.
# Never commit database passwords, access tokens, service-role keys, or API tokens.

# Public web application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Per-app public origin used for authentication callbacks. Set this to the
# externally reachable origin of each deployed app (patient, pharmacist, or
# pharmacy) in that app's environment.
MEDLINK_APP_URL=http://localhost:3000

# Server-side API origin used by patient, pharmacy, pharmacist, provider,
# dashboard, developer, and admin server components.
MEDLINK_API_URL=http://localhost:3000

# Pharmacist app origin used by pharmacist server-side API calls when it is
# deployed separately from the shared API origin.
MEDLINK_PHARMACIST_URL=http://localhost:3003

# Browser-visible API origin. Only use a public HTTPS endpoint in production.
# Leave empty when browser requests should use the current application origin.
NEXT_PUBLIC_MEDLINK_API_URL=

# Supabase public client configuration
# The anon key is browser-visible by design; authorization still depends on RLS.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_LOCAL_OR_HOSTED_ANON_KEY

# Supabase CLI / deployment configuration
SUPABASE_PROJECT_REF=REPLACE_WITH_PROJECT_REF
SUPABASE_DB_PASSWORD=REPLACE_WITH_SECRET_FROM_PASSWORD_MANAGER
SUPABASE_ACCESS_TOKEN=REPLACE_WITH_PERSONAL_ACCESS_TOKEN

# Optional authenticated API credential for external developer tooling only.
# Do not expose this value through a NEXT_PUBLIC_ variable.
MEDLINK_API_TOKEN=REPLACE_WITH_LEAST_PRIVILEGE_API_TOKEN

# WhatsApp Business Platform (server-side secrets)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=replace-with-meta-app-secret
WHATSAPP_VERIFY_TOKEN=replace-with-a-random-verification-token

# Hosted payment initiation and signed provider webhook authority.
# These are server-only secrets; use a real HTTPS provider URL outside E2E.
MEDLINK_PAYMENT_PROVIDER_URL=
MEDLINK_PAYMENT_PROVIDER_KEY=
PAYMENT_WEBHOOK_SECRET=

# Scheduled payment-refund dispatcher. Configure an external scheduler to POST
# /api/internal/payment-refund-dispatch with this bearer token.
MEDLINK_PAYMENT_REFUND_WORKER_TOKEN=replace-with-at-least-32-random-characters

# Private prescription storage
PRESCRIPTION_STORAGE_BUCKET=prescriptions

# Prescription upload malware scanner. The token is optional when the selected
# provider authenticates by another deployment-controlled mechanism.
MEDLINK_FILE_SCANNER_URL=
MEDLINK_FILE_SCANNER_TOKEN=

# Scheduled clinical pipeline and its OCR/structure providers. Configure an
# external scheduler to POST /api/internal/clinical-pipeline.
MEDLINK_CLINICAL_WORKER_TOKEN=replace-with-at-least-32-random-characters
MEDLINK_OCR_PROVIDER_URL=
MEDLINK_OCR_PROVIDER_TOKEN=
MEDLINK_PARSER_PROVIDER_URL=
MEDLINK_PARSER_PROVIDER_TOKEN=

# MVP location provider: internal, google, or mapbox
MAPS_PROVIDER=internal
MAPS_API_KEY=

# Governed AI gateway provider: disabled, openai, or azure-openai
AI_PROVIDER=disabled
AI_API_KEY=
AI_MODEL=

# Scheduled inventory-expiry and notification dispatchers. Configure external
# schedulers for /api/internal/inventory-expiry and
# /api/internal/notification-dispatch.
MEDLINK_INVENTORY_WORKER_TOKEN=replace-with-at-least-32-random-characters
MEDLINK_NOTIFICATION_WORKER_TOKEN=replace-with-at-least-32-random-characters

# Runtime observability
LOG_LEVEL=info
BUILD_ID=development

# Optional live-database certification. These are consumed only by
# `npm run test:live`; omit them for normal local tests.
MEDLINK_LIVE_SUPABASE_URL=
MEDLINK_LIVE_SUPABASE_ANON_KEY=
MEDLINK_LIVE_SUPABASE_SERVICE_KEY=

# Standard runtime mode: development, test, or production.
NODE_ENV=development

# Server-only. Never prefix with NEXT_PUBLIC_ -- these must never reach the
# client bundle. Used only by apps/web/app/api/whatsapp/webhook/route.ts
# (ADR 0004).
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Server-only. Used only by apps/patient/lib/assistant.ts (Alice, AG-02) --
# the first real AI Gateway consumer. ANTHROPIC_MODEL has no default on
# purpose: pick a real, currently-supported model id for your deployment
# rather than trusting a hardcoded default that will eventually go stale.
ANTHROPIC_API_KEY=replace-with-a-real-anthropic-api-key
ANTHROPIC_MODEL=replace-with-a-real-anthropic-model-id
# Optional provider-compatible endpoint override for certified simulators.
# Production uses Anthropic's official Messages endpoint when omitted.
# ANTHROPIC_ENDPOINT=http://127.0.0.1:4010/anthropic/messages
